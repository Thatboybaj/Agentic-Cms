# Copy to apps/cms/.env.local for local runs, or add these in Vercel → Project → Settings → Environment Variables.

# Real drafts from the blog writing agent. Leave empty to keep the simulated drafts.
DASHSCOPE_API_KEY=
# Optional: model for drafts (default qwen3.7-plus; qwen3.8-flash is cheaper).
QWEN_MODEL=
# Optional: cap draft length (default 1200 words) and drafts per visitor per hour (default 5).
LIVE_DRAFT_MAX_WORDS=
LIVE_DRAFTS_PER_HOUR=

# Optional, localhost only: encrypts provider keys saved under apps/cms/.data (openssl rand -base64 32).
CMS_SECRET_KEY=
