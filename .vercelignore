# Upload only what the build needs (vercel deploy from this machine). Secrets stay local: the
# deployment's settings live in the Vercel project, never in uploaded .env files.
.env*
!.env.example
**/.env*
!**/.env.example
node_modules
**/node_modules
.next
**/.next
.next-prod
**/.next-prod
apps/cms/.data
*.tsbuildinfo
**/*.tsbuildinfo
*.pdf
site-atlas
.DS_Store
