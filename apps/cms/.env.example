# Agentic CMS: environment names. Values are NEVER committed.
# Local: copy to apps/cms/.env.local. `npx convex dev` writes the CONVEX_* / NEXT_PUBLIC_CONVEX_* lines itself.
# Server-side secrets the Convex functions read go in the Convex deployment, not here:
#   npx convex env set NAME value          (per deployment: dev / staging / prod)
# Full matrix (tier × store × owner): docs/backend/env-matrix.md

# ── Tier A: platform (local + Vercel) ─────────────────────────────────────────
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Vercel / CI only (staging, prod):
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clock: the app is pinned to 25 Sep 2026 unless this is 1. Set it in every environment the backend runs in.
NEXT_PUBLIC_CMS_LIVE_CLOCK=1

# ── Tier D: observability (Vercel) ────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=

# ── Prototype only (replaced by Convex in backend phase B4) ───────────────────
# Next.js route handlers that still exist: /api/agents/draft, connections, templates, visual-agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
LIVE_DRAFT_MAX_WORDS=
LIVE_DRAFTS_PER_HOUR=
CMS_SECRET_KEY=

# ── Convex env (set with `npx convex env set`, listed here for reference only) ─
# CLERK_JWT_ISSUER_DOMAIN, CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET, FRONTEND_URL,
# ANTHROPIC_API_KEY, LANGFUSE_PUBLIC_KEY, LANGFUSE_SECRET_KEY, LANGFUSE_BASE_URL,
# CMS_SECRETS_KEY_V1, CMS_SECRETS_KEY_CURRENT, CMS_DEV_TOOLS (dev only), NEXT_PUBLIC_CMS_LIVE_CLOCK,
# POLAR_ACCESS_TOKEN, POLAR_ORGANIZATION_ID, POLAR_WEBHOOK_SECRET, POLAR_SERVER, AUTUMN_SECRET_KEY,
# SENTRY_DSN, PARALLEL_API_KEY, FIRECRAWL_API_KEY, BROWSERBASE_API_KEY, BROWSERBASE_PROJECT_ID,
# GITHUB_APP_ID, GITHUB_APP_SLUG, GITHUB_APP_PRIVATE_KEY, GITHUB_APP_WEBHOOK_SECRET, GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET,
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_OAUTH_REDIRECT_URI, R2_* (names per @convex-dev/r2)
